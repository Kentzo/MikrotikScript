        },
        {
          "type": "STRING",
          "value": ":foreach"
        },
        {
          "type": "STRING",
          "value": ":while"
        },
        {
          "type": "STRING",
          "value": ":do"
        },
        {
          "type": "STRING",
          "value": ":onerror"
        },
        {
          "type": "STRING",
          "value": ":on-error"
        },
        {
          "type": "STRING",
          "value": ":return"
        },
        {
          "type": "STRING",
          "value": ":break"
        },
        {
          "type": "STRING",
          "value": ":continue"
        },
        {
          "type": "STRING",
          "value": "do"
        },
        {
          "type": "STRING",
          "value": "else"
        },
        {
          "type": "STRING",
          "value": "from"
        },
        {
          "type": "STRING",
          "value": "to"
        },
        {
          "type": "STRING",
          "value": "step"
        },
        {
          "type": "STRING",
          "value": "in"
        },
        {
          "type": "STRING",
          "value": "where"
        },
        {
          "type": "STRING",
          "value": "and"
        },
        {
          "type": "STRING",
          "value": "or"
        },
        {
          "type": "STRING",
          "value": "not"
        }
      ]
    },
    "builtin": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": ":[a-zA-Z][a-zA-Z0-9_-]*"
      }
    },
    "boolean": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "STRING",
          "value": "false"
        },
        {
          "type": "STRING",
          "value": "yes"
        },
        {
          "type": "STRING",
          "value": "no"
        }
      ]
    },
    "ipv4": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[0-9]{1,3}(\\.[0-9]{1,3}){3}(\\/[0-9]{1,2})?"
        }
      }
    },
    "mac_address": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}"
        }
      }
    },
    "ipv6": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[0-9a-fA-F]{1,4}(:[0-9a-fA-F]{1,4}){2,7}(\\/[0-9]{1,3})?"
            },
            {
              "type": "PATTERN",
              "value": "([0-9a-fA-F]{1,4}(:[0-9a-fA-F]{1,4})*)?::([0-9a-fA-F]{1,4}(:[0-9a-fA-F]{1,4})*)?(\\/[0-9]{1,3})?"
            }
          ]
        }
      }
    },
    "duration": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "([0-9]+(ms|us|ns|s|m|h|d|w))+"
            },
            {
              "type": "PATTERN",
              "value": "[0-9]+:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?"
            }
          ]
        }
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "0[xX][0-9a-fA-F]+"
          },
          {
            "type": "PATTERN",
            "value": "[0-9]+(\\.[0-9]+)?"
          }
        ]
      }
    },
    "path": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "\\/[a-zA-Z][a-zA-Z0-9_-]*(\\/[a-zA-Z][a-zA-Z0-9_-]*)*"
        }
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_.-]*"
    },
    "internal_id": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\*[0-9a-fA-F]+"
      }
    },
    "operator": {
      "type": "CHOICE",
      "members": [
